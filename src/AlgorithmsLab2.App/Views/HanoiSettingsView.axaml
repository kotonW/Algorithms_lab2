<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AlgorithmsLab2.App.ViewModels"
             x:Class="AlgorithmsLab2.App.Views.HanoiSettingsView"
             x:DataType="vm:HanoiSettingsViewModel">

  <StackPanel Margin="16" Spacing="16">

    <StackPanel Spacing="6">
      <TextBlock Classes="section" Text="ПАРАМЕТРЫ" />

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="Количество колец" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding DiskCount}" />
      </Grid>

      <Slider Minimum="{Binding MinDisks}"
              Maximum="{Binding MaxDisks}"
              Value="{Binding DiskCount}"
              TickFrequency="1"
              IsSnapToTickEnabled="True" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
        <TextBlock Classes="muted" Text="Задержка между ходами, мс" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding StepDelayMs}" />
      </Grid>

      <Slider Minimum="{Binding MinDelayMs}"
              Maximum="{Binding MaxDelayMs}"
              Value="{Binding StepDelayMs}"
              TickFrequency="10"
              IsSnapToTickEnabled="True" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Classes="section" Text="УПРАВЛЕНИЕ" />

      <Button Classes="primary"
              HorizontalAlignment="Stretch"
              Content="{Binding PlaybackText}"
              Command="{Binding TogglePlaybackCommand}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button HorizontalAlignment="Stretch"
                Content="Шаг назад"
                Command="{Binding StepBackCommand}" />
        <Button Grid.Column="1"
                HorizontalAlignment="Stretch"
                Content="Шаг вперёд"
                Command="{Binding StepForwardCommand}" />
      </Grid>

      <Button HorizontalAlignment="Stretch"
              Content="Сбросить"
              Command="{Binding ResetCommand}" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Classes="section" Text="СРАВНЕНИЕ" />

      <Button Classes="primary"
              HorizontalAlignment="Stretch"
              Content="Сравнить рекурсию и стек"
              Command="{Binding RunBenchmarkCommand}" />

      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding BenchmarkText}" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Classes="section" Text="ИНФОРМАЦИЯ" />

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="Всего ходов (2^n − 1)" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding TotalMovesText}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="Сделано ходов" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding MovesMadeText}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="Осталось ходов" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding MovesLeftText}" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" Text="Прогресс" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding ProgressText}" />
      </Grid>

      <TextBlock Classes="muted" Text="Текущий ход" Margin="0,6,0,0" />
      <TextBlock Classes="info" TextWrapping="Wrap" Text="{Binding CurrentMoveText}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="ЖУРНАЛ ХОДОВ" />
        <TextBlock Grid.Column="1" Classes="value" Text="{Binding MovesMadeText}" />
      </Grid>

      <ListBox Height="240"
               ItemsSource="{Binding MoveLog}"
               SelectedIndex="{Binding LogSelectedIndex, Mode=OneWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HanoiLogEntry">
            <Grid ColumnDefinitions="48,*">
              <TextBlock Classes="muted" Text="{Binding Number}" />
              <TextBlock Grid.Column="1" Text="{Binding MoveText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

  </StackPanel>
</UserControl>
